---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Advocacy - Yannis Tevissen";
const description =
  "Talks, writing, and public contributions on disability inclusion, accessibility, and representation in AI.";
const keywords =
  "Yannis Tevissen advocacy, disability inclusion, accessibility in tech, AI bias, representation, TEDx, OECD, DiverseSpectrum";
const footerSecondaryLinks = [
  { href: "/research/", label: "Research" },
  { href: "/blog/", label: "Blog & Press" },
];
---

<BaseLayout title={title} description={description} keywords={keywords} footerSecondaryLinks={footerSecondaryLinks}>
  <main id="site-main" class="site-main">
    <div class="site-shell">
      <h1 class="page-title">Advocacy</h1>
      <p class="page-lede">
        Disability inclusion and accessibility in tech are personal to me, and this page collects the talks, writing,
        and projects that come out of that. Technical notes, press coverage, and general talks are on
        <a href="/blog/">Blog &amp; Press</a>.
      </p>

      <section aria-labelledby="talks-heading">
        <h2 id="talks-heading">Talks &amp; panels</h2>
        <p class="page-lede" style="margin-bottom: 0.75rem; margin-top: 0.25rem">
          Where disability, bias, and representation are the subject rather than a passing mention.
        </p>
        <ul class="pub-list">
          <li class="pub-item">
            <p class="pub-title">OECD — AI and disability</p>
            <p class="pub-meta">
              <time datetime="2024-12">December 2024</time> · Panel on recommendations for inclusive AI development, at the
              Association APHPP colloquium hosted by the OECD ·
              <a href="https://www.youtube.com/watch?v=_CYn7HXEWuM&t=7140s">Video</a>
            </p>
          </li>
          <li class="pub-item">
            <p class="pub-title">TEDx — <span lang="fr">Handicap, Société et IA, une histoire de biais</span></p>
            <p class="pub-meta">
              <time datetime="2024-03">March 2024</time> · TEDxTélécom SudParis ·
              <a href="https://www.youtube.com/watch?v=9M6xRLEkyV8" hreflang="fr">Video</a>
            </p>
          </li>
          <li class="pub-item">
            <p class="pub-title">Déclics Numérique — Diversidays</p>
            <p class="pub-meta">
              <time datetime="2023-08">August 2023</time> · Workshop on digital inclusion and diversity in tech
            </p>
          </li>
          <li class="pub-item">
            <p class="pub-title" lang="fr">Témoignage sur mon parcours en école d'ingénieurs</p>
            <p class="pub-meta">
              <time datetime="2022-04">April 2022</time> · Télécom SudParis ·
              <a href="https://www.telecom-sudparis.eu/ecole/handicap/">Page handicap</a>
            </p>
          </li>
        </ul>
      </section>

      <section aria-labelledby="writing-heading">
        <h2 id="writing-heading">Writing</h2>
        <ul class="pub-list">
          <li class="pub-item">
            <p class="pub-title">Graduate School Decoded: How to Navigate the Ph.D. with a Physical Disability</p>
            <p class="pub-meta">
              <time datetime="2023-08">August 2023</time> · The Ability Toolbox ·
              <a href="https://theabilitytoolbox.com/navigate-phd-physical-disability/">Article</a>
            </p>
          </li>
        </ul>
      </section>

      <section aria-labelledby="projects-heading">
        <h2 id="projects-heading">Projects &amp; datasets</h2>
        <ul class="pub-list">
          <li class="pub-item">
            <p class="pub-title">DiverseSpectrum</p>
            <p class="pub-meta">
              <time datetime="2026-01">January 2026</time> · Open image dataset addressing the representation gap for minorities
              in popular AI training data
            </p>
          </li>
          <li class="pub-item">
            <p class="pub-title">
              <a href="https://huggingface.co/collections/YannisTevissen/ai-for-disability-67684a1a9966a2e699f6b114"
                >AI for Disability</a
              >
            </p>
            <p class="pub-meta">
              Curated Hugging Face collection of datasets, models, spaces, and papers using AI for disability-related
              tasks
            </p>
            <div class="artifact-links" aria-label="Artifacts for AI for Disability">
              <a href="https://huggingface.co/collections/YannisTevissen/ai-for-disability-67684a1a9966a2e699f6b114"
                >Hugging Face collection</a
              >
            </div>
          </li>
          <li class="pub-item">
            <p class="pub-title">Board member — Universal Wings Mobility</p>
            <p class="pub-meta">
              <time datetime="2025-07">July 2025</time> – present · AVI conversational agent for accessible travel planning
            </p>
          </li>
        </ul>
        <p class="section-foot">
          More open data and code, including the SMA research collection, is on the
          <a href="/research/#artifacts">Artifacts</a> section.
        </p>
      </section>

      <section aria-labelledby="overlap-heading">
        <h2 id="overlap-heading">Research overlap</h2>
        <p>
          The same subject is also a research line. The paper on disability representation in image generation is listed
          with the <a href="/research/#publications">publications</a>:
        </p>
        <ul class="pub-list">
          <li class="pub-item">
            <p class="pub-title">Disability Representations: Finding Biases in Automatic Image Generation</p>
            <p class="pub-meta">Yannis Tevissen · CVPR 2024 Workshop AVA</p>
          </li>
        </ul>
      </section>

      <p class="section-foot">
        <a href="/blog/">Blog &amp; Press →</a>
      </p>
    </div>
  </main>
</BaseLayout>
