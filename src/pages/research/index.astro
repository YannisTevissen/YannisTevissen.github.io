const footerSecondaryLinks = [
  { href: "/blog/", label: "Blog & Press" },
  { href: "/advocacy/", label: "Advocacy" },
  { href: "/contact/", label: "Contact" },
];

type Artifact = {
  name: string;
  href: string;
  kind: "Dataset" | "Model" | "Code" | "Space" | "Collection";
  summary: string;
  meta?: string;
  links?: { label: string; href: string }[];
};

type ArtifactGroup = {
  id: string;
  heading: string;
  lede: string;
  items: Artifact[];
};

const artifactGroups: ArtifactGroup[] = [
  {
    id: "video-understanding",
    heading: "Video understanding research",
    lede: "Code and data behind the frame selection, captioning, retrieval, and diarization work, across video, image, and speech. The recurring question is how much of the available signal a model actually needs, and how to tell when a reported gain is real rather than an artefact of how the input was sampled.",
