        name: "Open SMA Research Data",
        href: "https://huggingface.co/collections/YannisTevissen/open-sma-research-data",
        kind: "Collection",
        summary:
          "A provenance-first index of the spinal muscular atrophy data that is genuinely open, mirrored from the original studies with attribution and checksums, plus a derived reach-intent benchmark and a browser explorer. Licences, access conditions, and stated limitations sit with each repository.",
        links: [
          {
            label: "Collection",
            href: "https://huggingface.co/collections/YannisTevissen/open-sma-research-data",
          },
          { label: "Explorer", href: "https://huggingface.co/spaces/YannisTevissen/sma-data-explorer" },
