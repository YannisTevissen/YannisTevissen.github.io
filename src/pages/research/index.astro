      {
        name: "PEEK",
        href: "https://github.com/momentslab/peek",
        kind: "Code",
        summary:
          "A lightweight dynamic frame selector that distils caption-conditioned relevance from a teacher model, for video captioning under a small frame budget. BMVC 2026.",
