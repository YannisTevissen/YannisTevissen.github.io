// Only link a profile Yannis supplied, published himself, or tagged. Never one found
// by name search: a wrong profile on a real person's name is not recoverable.
const mentees: Mentee[] = [
  { name: "Killian Steunou", role: "PhD", linkedin: "https://www.linkedin.com/in/killian-steunou" },
