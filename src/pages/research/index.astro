      {
        name: "VoxConverse TSCPD",
        href: "https://huggingface.co/datasets/YannisTevissen/voxconverse_tscpd",
        kind: "Dataset",
        summary:
          "Speaker change point annotations derived from VoxConverse, for evaluating text-side change detection in diarization pipelines.",
        meta: "BSD 3-Clause",
      },
    ],
  },
  {
    id: "ai-for-science",
    heading: "AI for science",
    lede: "Retrieval and evidence grounding applied to scientific literature and clinical data, and the data work that makes capability-conditioned settings measurable at all.",
    items: [
      {
        name: "UpToCure",
        href: "https://github.com/YannisTevissen/UpToCure",
        kind: "Code",
        summary:
          "Assembles published research on rare diseases into readable, sourced reports, applying retrieval and evidence grounding to scientific literature.",
      },
