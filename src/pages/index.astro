---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import { SITE } from "../lib/site";

const title = "Yannis Tevissen - Head of Research at Moments Lab";
const description =
  "How can a model efficiently understand long-context data with complex temporal, spatial, and narrative dependencies? Research at Moments Lab, with work on fairness, accessibility, and disability representation.";
const keywords =
  "Yannis Tevissen, multimodal retrieval, video understanding, video indexing, frame selection, PEEK, vision language models, AI fairness, accessibility, assistive technology, AI4Science, Moments Lab, Head of Research";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Yannis Tevissen",
  url: "https://yannistevissen.fr/",
  jobTitle: "Head of Research",
  worksFor: {
    "@type": "Organization",
    name: "Moments Lab",
    url: "https://momentslab.com",
  },
  sameAs: [
    "https://scholar.google.com/citations?user=jEnK4FIAAAAJ",
    "https://www.linkedin.com/in/yannis-tevissen",
    "https://github.com/YannisTevissen",
    "https://huggingface.co/YannisTevissen",
    "https://bsky.app/profile/yannistevissen.fr",
    "https://x.com/yannistevissen",
  ],
  email: "mailto:contact@yannistevissen.fr",
  image: "https://yannistevissen.fr/assets/img/profile.png",
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Institut Polytechnique de Paris",
  },
  knowsAbout: [
    "Multimodal retrieval",
    "Multimodal reasoning",
    "Video indexing",
    "Frame selection",
    "Large-scale video data",
    "AI fairness",
    "Speaker diarization",
    "Accessibility and assistive technology",
    "AI for science",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Yannis Tevissen",
  url: "https://yannistevissen.fr/",
  description:
    "Multimodal retrieval and reasoning: how a model can efficiently understand long-context data with complex temporal, spatial, and narrative dependencies.",
};

type WorkEntry = {
  /** Conference or venue shown as the card badge. */
  venue: string;
  /** Optional award line shown next to the venue badge. */
  award?: string;
  title: string;
  href: string;
  summary: string;
  /**
   * Teaser figure. Drop a file in /public/assets/img/work/ and reference it here.
   * Set `wide` for a 2:1 source, which is shown at its own ratio instead of being
   * cropped to the 16:10 the other figures use.
   */
  figure?: { src: string; alt: string; wide?: boolean };
  /** Looping teaser clip. `poster` is what reduced-motion users and slow connections see. */
  clip?: { src: string; poster: string; alt: string };
  links: { label: string; href: string }[];
};

const selectedWork: WorkEntry[] = [
  {
    venue: "BMVC 2026",
    title: "PEEK: Picking Essential frames via Efficient Knowledge distillation",
    href: "https://arxiv.org/abs/2605.31029",
    summary:
      "Distils caption-conditioned relevance from a teacher model into a small frame selector, so a captioning model can work from far fewer frames.",
    clip: {
      src: "/assets/img/work/peek.mp4",
      poster: "/assets/img/work/peek-poster.jpg",
      alt: "PEEK selecting the informative frames of a basketball dunk clip, shown as an overlay on the video",
    },
    links: [
      { label: "arXiv", href: "https://arxiv.org/abs/2605.31029" },
      { label: "Code", href: "https://github.com/momentslab/peek" },
      { label: "Hugging Face", href: "https://huggingface.co/papers/2605.31029" },
      { label: "Project page", href: "https://www.killian-steunou.com/peek/" },
    ],
  },
  {
    venue: "HSI 2024",
    award: "Best Presentation",
    title: "Towards Retrieval Augmented Generation over Large Video Libraries",
    href: "https://arxiv.org/abs/2406.14938",
    summary:
      "Answers questions about a large video library by retrieving the relevant segments first and generating only from what came back, so the answer can cite the moments it rests on.",
    figure: {
      src: "/assets/img/items/pub_rag_video.svg",
      alt: "A query searches a library of indexed video segments; three matching segments are retrieved and grounded into an answer that cites specific moments",
    },
    links: [
      { label: "arXiv", href: "https://arxiv.org/abs/2406.14938" },
      { label: "Hugging Face", href: "https://huggingface.co/papers/2406.14938" },
      { label: "Research note", href: "https://research.momentslab.com/blog-posts/rag-video-libraries" },
      { label: "DOI", href: "https://doi.org/10.1109/HSI61632.2024.10613524" },
    ],
  },
  {
    venue: "AVA @ CVPR 2024",
    title: "Disability Representations: Finding Biases in Automatic Image Generation",
    href: "https://arxiv.org/abs/2406.14993",
    summary:
      "Measures how image generation models depict disability. Prompted only for “a disabled man” and “a disabled woman”, Midjourney and SDXL Turbo returned a wheelchair every time.",
    figure: {
      src: "/assets/img/items/pub_disability.jpg",
      alt: "Eight generated portraits, four from Midjourney for the prompt “a disabled man” and four from SDXL Turbo for “a disabled woman”. Every one shows a seated wheelchair user, the men in dark and gritty scenes and the women older and in bright daylight.",
      wide: true,
    },
    links: [
      { label: "arXiv", href: "https://arxiv.org/abs/2406.14993" },
      { label: "Hugging Face", href: "https://huggingface.co/papers/2406.14993" },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogImageAlt="Yannis Tevissen, Head of Research at Moments Lab"
  twitterCard="summary_large_image"
  showFeedLink
  bodyClass="page-home"
>
  <Fragment slot="head-extra">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
  </Fragment>

  <main id="site-main" class="site-main site-main--home">
    <div class="site-shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-layout">
          <figure class="hero-figure">
            <div class="hero-photo-wrap">
              <img
                class="hero-photo"
                src="/assets/img/profile.png"
                alt="Photo of Yannis Tevissen"
                width="136"
                height="136"
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption class="hero-caption">
              <ProfileLinks ariaLabel="Profiles" eager />
            </figcaption>
          </figure>
          <div class="hero-copy">
            <h1 id="hero-title" class="hero-role">
              Head of Research · <a href="https://research.momentslab.com">Moments Lab</a>
            </h1>
            <p class="hero-lead">
              I lead research on <a href="/research/">multimodal retrieval and reasoning</a> at
              <a href="https://research.momentslab.com">Moments Lab</a>, after a PhD at
              <a href="https://www.ip-paris.fr/">Institut Polytechnique de Paris</a> on
              <a href="/research/#thesis">multimodal speaker diarization</a>, advised by Jérôme Boudy and Gérard
              Chollet. One question governs my work: how can a model efficiently understand long-context data with
              complex temporal, spatial and narrative dependencies?
            </p>
            <p>
              I also contribute to research on <a href="https://arxiv.org/abs/2302.09991">fairness</a>, accessibility
              and
              <a href="https://arxiv.org/abs/2406.14993">disability representation</a> while openly
              <a href="https://theabilitytoolbox.com/navigate-phd-physical-disability/">writing</a>,
              <a href="/advocacy/">speaking about my experience</a> and advocating for a more inclusive science.
            </p>
            <p>
              Finally, I built <a href="https://github.com/YannisTevissen/UpToCure">UpToCure</a>, which assembles
              research on rare diseases into readable, sourced reports. I co-founded
              <a href="https://www.linkedin.com/company/vocacoach/">VocaCoach</a>, a speech training platform (€1M
              valuation,
              <a
                href="https://www.telecom-sudparis.eu/ecole/vocacoach-remporte-le-prix-coup-de-coeur-au-next-startupper-challenge-a-vivatech/"
                >VivaTech award</a
              >, covered by
              <a
                href="https://www.leparisien.fr/vie-de-bureau/vocacoach-une-nouvelle-plate-forme-pour-sentrainer-a-parler-en-public-03-02-2022-7LVIIAH7FJAAPMKKBURFIYCI4I.php"
                >Le Parisien</a
              >), and serve on the board of <a href="https://universalwings.org/">Universal Wings Mobility</a>, the
              French startup building AVI, a smart travel assistant for people with disabilities.
            </p>
            <div class="hero-actions">
              <a href="/research/">Research</a>
              <span aria-hidden="true">·</span>
              <a href="/research/#publications">Publications</a>
              <span aria-hidden="true">·</span>
              <a href="/research/#artifacts">Artifacts</a>
              <span aria-hidden="true">·</span>
              <a href={SITE.cvPath}>CV (PDF)</a>
              <span aria-hidden="true">·</span>
              <a href="/contact/">Contact</a>
            </div>
          </div>
        </div>
      </section>

      <section class="home-card home-card--focus" aria-labelledby="focus-heading">
        <h2 class="section-label" id="focus-heading">Research focus</h2>
        <div class="pillars">
          <div class="pillar">
            <h3>Multimodal learning</h3>
            <p>
              A useful answer usually needs more than one signal at once: vision, language, audio, and time. I build
              models and pipelines that combine those modalities so retrieval and reasoning stay grounded in what
              actually happened in the input.
            </p>
          </div>
          <div class="pillar">
            <h3>Long context efficiency</h3>
            <p>
              Long inputs are expensive to process and easy to summarise poorly. I work on selecting and compressing
              evidence so a model can handle hours of video or speech without losing the moments that matter.
            </p>
          </div>
          <div class="pillar">
            <h3>Fairness and biases</h3>
            <p>
              Models inherit the gaps in their training data, and the people furthest from the distribution pay for it
              first. I measure how disability and demographic biases show up in vision and speech systems, and I build
              open data and benchmarks for those settings.
            </p>
          </div>
        </div>
        <p class="section-foot"><a href="/research/">More on the research agenda →</a></p>
      </section>

      <section class="home-card home-card--selected" aria-labelledby="selected-heading">
        <h2 id="selected-heading">Selected work</h2>
        <p class="page-lede" style="margin-bottom: 0.5rem">
          Three papers that carry the agenda. The full record is under
          <a href="/research/#publications">Publications</a>; the code, datasets, and demos are under <a
            href="/research/#artifacts">Artifacts</a
          >.
        </p>
        <ul class="work-list">
          {
            selectedWork.map((entry) => (
              <li class={entry.figure || entry.clip ? "work-card work-card--figure" : "work-card"}>
                {entry.clip && (
                  <figure class="work-figure">
                    <a class="work-figure-link" href={entry.href} tabindex="-1">
                      <video
                        src={entry.clip.src}
                        poster={entry.clip.poster}
                        aria-label={entry.clip.alt}
                        autoplay
                        loop
                        muted
                        playsinline
                        preload="metadata"
                      />
                    </a>
                  </figure>
                )}
                {entry.figure && !entry.clip && (
                  <figure class:list={["work-figure", entry.figure.wide && "work-figure--wide"]}>
                    {/* Not a tab stop: the title link below goes to the same place, so a
                        second one would only add a duplicate stop for keyboard users. */}
                    <a class="work-figure-link" href={entry.href} tabindex="-1">
                      <img src={entry.figure.src} alt={entry.figure.alt} loading="lazy" decoding="async" />
                    </a>
                  </figure>
                )}
                <div class="work-card-header">
                  <p class="work-venue-row">
                    <span class="work-venue">{entry.venue}</span>
                    {entry.award && <span class="work-venue-award">{entry.award}</span>}
                  </p>
                  <p class="work-card-title">
                    <a href={entry.href}>{entry.title}</a>
                  </p>
                </div>
                <p>{entry.summary}</p>
                <div class="artifact-links" aria-label={`Artifacts for ${entry.title}`}>
                  {entry.links.map((link) => (
                    <a href={link.href}>{link.label}</a>
                  ))}
                </div>
              </li>
            ))
          }
        </ul>
        <p class="section-foot"><a href="/research/#publications">See all publications →</a></p>
      </section>

      <section class="home-card home-card--sections" aria-labelledby="sections-heading">
        <h2 id="sections-heading">See also</h2>
        <div class="pillars">
          <div class="pillar">
            <h3><a href="/research/">Research</a></h3>
            <p>
              The research agenda, <a href="/research/#publications">publications</a>,
              <a href="/research/#artifacts">artifacts</a>, and
              <a href="/research/#teaching">teaching and mentoring</a>.
            </p>
          </div>
          <div class="pillar">
            <h3><a href="/advocacy/">Blog &amp; Advocacy</a></h3>
            <p>
              Technical notes, press, and talks on <a href="/blog/">Blog &amp; Press</a>, and disability and
              accessibility work under <a href="/advocacy/">advocacy</a>.
            </p>
          </div>
          <div class="pillar">
            <h3><a href="/contact/">Contact</a></h3>
            <p>
              Email and profiles for research collaboration, speaking invitations, or technical discussion, plus the
              <a href="/cv/">resume</a>.
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    // A looping clip is motion the user may not want. Honour the OS setting:
    // stop autoplay, show the poster, and expose controls so it stays reachable.
    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll(".work-figure video[autoplay]").forEach((video) => {
        video.autoplay = false;
        video.loop = false;
        video.controls = true;
        video.pause();
      });
    }
  </script>
</BaseLayout>
