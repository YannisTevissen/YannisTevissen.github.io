---
const to = "/research/#artifacts";
const title = "Redirecting to Research - artifacts";
const canonical = "https://yannistevissen.fr/research/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <script is:inline>
      (() => {
        // Preserve deep links such as /artifacts/#ai-for-science on the research page.
        const hash = location.hash;
        location.replace(hash && hash !== "#" ? `/research/${hash}` : "/research/#artifacts");
      })();
    </script>
  </head>
  <body>
    <p>
      Open datasets, models, code, and demos live under Artifacts on the Research page.
      <a href={to}>Continue</a>.
    </p>
  </body>
</html>
