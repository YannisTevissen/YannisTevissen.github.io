---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import { SITE } from "../lib/site";

const title = "Contact - Yannis Tevissen";
const description =
  "Contact Yannis Tevissen for research collaboration on multimodal retrieval and reasoning over video data.";
---

<BaseLayout title={title} description={description} showFooterContact={false} footerId={null}>
  <main id="site-main" class="site-main">
    <div class="site-shell">
      <h1 class="page-title">Contact</h1>
      <p class="page-lede">For research collaboration, speaking invitations, or technical discussion.</p>

      <p class="contact-email"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>

      <ProfileLinks variant="labelled" ariaLabel="Profiles" />

      <p class="section-foot">
        <a href="/cv/">Resume</a> ·
        <a href={SITE.cvPath} download="CV_YannisTevissen_en.pdf">CV (PDF)</a>
      </p>
    </div>
  </main>
</BaseLayout>
