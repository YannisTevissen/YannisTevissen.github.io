    key: "bluesky",
    label: "Bluesky",
    href: "https://bsky.app/profile/yannistevissen.fr",
    path: "M12 10.8C10.91 8.69 7.95 4.75 5.2 2.81 2.57.94 1.56 1.27.9 1.57.14 1.91 0 3.08 0 3.77c0 .69.38 5.65.62 6.48.82 2.73 3.72 3.66 6.39 3.36.13-.02.27-.04.41-.06-.14.02-.27.04-.41.06-3.91.58-7.39 2-2.83 7.08 5.01 5.19 6.87-1.12 7.82-4.31.95 3.19 2.05 9.27 7.73 4.31 4.27-4.31 1.17-6.5-2.74-7.08a8.7 8.7 0 0 1-.41-.06c.14.02.28.04.41.06 2.67.3 5.57-.63 6.39-3.36.24-.83.62-5.79.62-6.48 0-.69-.14-1.86-.9-2.2-.66-.3-1.67-.63-4.3 1.24C16.05 4.75 13.09 8.69 12 10.8Z",
