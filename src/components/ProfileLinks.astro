---
/**
 * The profile logo row, shared by the home page hero and the contact page.
 * Brand colours are baked into the paths but neutralised to currentColor in CSS,
 * so the same markup reads as a quiet cluster in the hero and as a list on Contact.
 */
interface Props {
  variant?: "icons" | "labelled";
  ariaLabel?: string;
  class?: string;
  eager?: boolean;
}

const { variant = "icons", ariaLabel = "Profiles", class: className, eager = false } = Astro.props;

type Profile = {
  key: string;
  label: string;
  href: string;
  /** Inline SVG body, or an image path for logos only available as a file. */
  path?: string;
  viewBox?: string;
  img?: string;
};

const PROFILES: Profile[] = [
  {
    key: "scholar",
    label: "Google Scholar",
    href: "https://scholar.google.com/citations?user=jEnK4FIAAAAJ",
    path: "M12 2L1 9l4 2.6V18l7 4 7-4v-6.4l3-1.95V18h2V9L12 2zm0 2.36L19.27 9 12 13.64 4.73 9 12 4.36zM7 13.07l5 3.27 5-3.27V16.8l-5 2.86-5-2.86v-3.73z",
  },
  {
    key: "linkedin",
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/yannis-tevissen",
    path: "M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z",
  },
  {
    key: "github",
    label: "GitHub",
    href: "https://github.com/YannisTevissen",
    path: "M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.02c-3.2.7-3.88-1.54-3.88-1.54-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18.92-.26 1.9-.38 2.88-.39.98.01 1.96.13 2.88.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z",
  },
  {
    key: "hf",
    label: "Hugging Face",
    href: "https://huggingface.co/YannisTevissen",
    img: "/assets/img/huggingface_logo-noborder.svg",
