const loading = eager ? "eager" : "lazy";
---

{
  variant === "icons" ? (
    <div
      class:list={["hero-quick-links", "hero-quick-links--icons", "hero-quick-links--brand", className]}
      aria-label={ariaLabel}
    >
      {PROFILES.map((p) => (
        <a class={`brand-icon brand-icon--${p.key}`} href={p.href} rel="me" aria-label={p.label} title={p.label}>
          {p.img ? (
            <img src={p.img} alt="" width="95" height="88" loading={loading} />
          ) : (
            <svg viewBox={p.viewBox ?? "0 0 24 24"} aria-hidden="true" focusable="false">
              <path d={p.path} />
            </svg>
          )}
        </a>
      ))}
    </div>
  ) : (
    <ul class:list={["profile-list", className]} aria-label={ariaLabel}>
      {PROFILES.map((p) => (
        <li>
          <a href={p.href} rel="me">
            <span class={`brand-icon brand-icon--${p.key}`} aria-hidden="true">
              {p.img ? (
                <img src={p.img} alt="" width="95" height="88" loading={loading} />
              ) : (
                <svg viewBox={p.viewBox ?? "0 0 24 24"} aria-hidden="true" focusable="false">
                  <path d={p.path} />
                </svg>
              )}
            </span>
            <span>{p.label}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
